CREATE TABLE outbox (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  seq INTEGER NOT NULL,
  table_name TEXT NOT NULL,
  row_id INTEGER NOT NULL,
  action TEXT NOT NULL,
  payload TEXT NOT NULL DEFAULT '',
  created_at INTEGER NOT NULL
);

CREATE INDEX idx_outbox_seq ON outbox(seq);

CREATE TABLE settings (
  key TEXT PRIMARY KEY,
  value TEXT NOT NULL
);

ALTER TABLE todo ADD COLUMN updated_at INTEGER NOT NULL DEFAULT 0;
ALTER TABLE todo ADD COLUMN updated_by TEXT NOT NULL DEFAULT '';
ALTER TABLE reminder_list ADD COLUMN updated_at INTEGER NOT NULL DEFAULT 0;
ALTER TABLE reminder_list ADD COLUMN updated_by TEXT NOT NULL DEFAULT '';

UPDATE todo SET updated_at = created_at;
UPDATE reminder_list SET updated_at = created_at;
